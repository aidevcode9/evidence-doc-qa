# Prompt version used in version snapshots and eval gating.
DOCQA_PROMPT_VERSION=v3.1.0
# Retrieval version used in version snapshots and eval gating.
DOCQA_RETRIEVAL_VERSION=v3.1.0
# Model identifier recorded in telemetry and evals.
DOCQA_MODEL_ID=gpt5-mini
# Parser mode for ingestion (tier0/tier1/tier2).
DOCQA_PARSER_MODE=tier0
# Index version recorded on index records.
DOCQA_INDEX_VERSION=v3.1.0

# Base data directory for raw files and local DB.
DOCQA_DATA_DIR=data
# Postgres connection string (Supabase or Azure Postgres).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Legacy alias (optional). Prefer DATABASE_URL.
DB_DATABASE_URL=
# Deterministic chunk size (characters).
DOCQA_CHUNK_SIZE=900
# Deterministic chunk overlap (characters).
DOCQA_CHUNK_OVERLAP=150
# Minimum confidence threshold for answers (FR-024).
# Below this threshold, the system returns "insufficient evidence" instead of guessing.
# Exposed in API response as evidence.confidence_threshold for UI display.
DOCQA_CONFIDENCE_THRESHOLD=0.70
# Azure hybrid search score threshold for confidence gating.
DOCQA_AZURE_SEARCH_SCORE_MIN=0.02
# Azure semantic reranker score threshold for confidence gating.
DOCQA_AZURE_RERANK_MIN=1.5
# Confidence calibration version label.
DOCQA_CONFIDENCE_VERSION=v1
# Require strong evidence and verified support before answering.
DOCQA_STRICT_EVIDENCE=1
# Allow unverified answers for human evaluation (0/1).
DOCQA_ALLOW_UNVERIFIED=0

# Use local (hash-based) embeddings when true; false indicates remote embeddings.
EMBEDDINGS_LOCAL=false
# Embedding mode override (local/remote). Ignored when EMBEDDINGS_LOCAL is set.
EMBEDDINGS_MODE=remote
# Embedding vector size for local embeddings.
EMBEDDINGS_DIM=16

# Azure OpenAI endpoint (e.g., https://<name>.openai.azure.com).
AZURE_OPENAI_ENDPOINT=
# Azure OpenAI API key.
AZURE_OPENAI_API_KEY=
# Azure OpenAI API version.
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# Azure OpenAI embeddings deployment name.
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# Azure OpenAI chat (verification) overrides (optional).
AZURE_OPENAI_CHAT_ENDPOINT=
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_CHAT_API_VERSION=

# Azure Blob Storage connection info.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=docqa-raw

# Azure AI Search endpoint (e.g., https://<name>.search.windows.net).
# Azure AI Search endpoint (e.g., https://<your-search>.search.windows.net)
AZURE_SEARCH_ENDPOINT=
# Azure AI Search admin/query API key.
AZURE_SEARCH_API_KEY=
# Azure AI Search index name.
AZURE_SEARCH_INDEX=docqa-index-v3
# Enable Azure semantic ranking features when supported.
DOCQA_AZURE_SEMANTIC_ENABLED=1
# Create index on startup when set to 1.
AZURE_SEARCH_CREATE_INDEX=0
# Enable indexing pipeline when set to 1.
DOCQA_ENABLE_INDEXING=1

# --- Document Parsing (NFR-036) ---
# Parser provider: pypdf (digital PDFs only, default), marker (OCR), llamaparse (cloud OCR)
PARSER_PROVIDER=pypdf
# Maximum upload file size in MB.
DOCQA_MAX_UPLOAD_SIZE_MB=50
# Minimum extracted text chars before warning is returned.
DOCQA_MIN_EXTRACTED_TEXT_CHARS=10

# Marker-specific (only used when PARSER_PROVIDER=marker)
# Enable LLM enhancement for better accuracy (requires Gemini or Ollama).
MARKER_USE_LLM=false
# Force OCR even on digital PDFs (useful for scanned documents).
MARKER_FORCE_OCR=false

# LlamaParse-specific (only used when PARSER_PROVIDER=llamaparse)
# Get API key from https://cloud.llamaindex.ai/ (free tier: 1000 pages/day)
LLAMAPARSE_API_KEY=

# Static token for /v1/metrics (set empty to disable auth).
DOCQA_METRICS_ADMIN_TOKEN=
# Cost tracking (per 1K tokens; demo defaults, override with real pricing).
DOCQA_MODEL_COST_INPUT_PER_1K=0.0004
DOCQA_MODEL_COST_OUTPUT_PER_1K=0.0016
DOCQA_EMBEDDINGS_COST_PER_1K=0.0001
# Shared beta access code for the demo login gate (set your own secret code).
DOCQA_BETA_CODE=your-secret-beta-code
# Enable OpenTelemetry tracing (0/1).
DOCQA_OTEL_ENABLED=0
# OpenTelemetry service name.
OTEL_SERVICE_NAME=docqa-api
# Azure Application Insights connection string (set by Azure when enabled).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Langfuse LLM Observability (NFR-045, NFR-046) ---
# Langfuse provides a debugging UI for LLM traces.
# Enable Langfuse tracing (0/1). Requires PUBLIC_KEY and SECRET_KEY.
LANGFUSE_ENABLED=1
# Langfuse API keys (get from https://cloud.langfuse.com Settings → API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse host (cloud.langfuse.com or self-hosted URL for NFR-046)
LANGFUSE_HOST=https://cloud.langfuse.com

# Comma-separated list of allowed origins for CORS.
DOCQA_ALLOWED_ORIGINS=http://localhost:3000
# Total results returned after fusion.
DOCQA_TOP_K=5
# Number of vector results retrieved before fusion.
DOCQA_TOP_K_VECTOR=5
# Number of BM25 results retrieved before fusion.
DOCQA_TOP_K_BM25=5
# RRF constant used in fusion scoring.
DOCQA_RRF_K=60

# --- Provider Abstraction (NFR-032, NFR-034, NFR-035) ---
# These settings allow swapping Azure services for open-source alternatives via config only.

# LLM Provider: azure_openai (default), ollama, gemini, anthropic
LLM_PROVIDER=azure_openai

# --- Ollama (local open-source models) ---
# Install: https://ollama.ai | Run: ollama serve | Pull model: ollama pull llama3.2:8b
# Recommended models: llama3.2:8b (16GB RAM), mistral:7b (fast), qwen2.5:7b (structured)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:8b

# --- Google Gemini ---
# Get API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic Claude ---
# Get API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Search Provider: azure (Azure AI Search), local (PostgreSQL + pgvector)
# Use "local" for on-prem deployment with pgvector
SEARCH_PROVIDER=azure

# Maximum query length in characters (security - prevents token overflow attacks)
DOCQA_MAX_QUERY_LENGTH=4000

# --- Authentication (FR-050, FR-054) ---
# Auth mode: jwt (production), headers (development/demo)
AUTH_MODE=headers

# Auth Bypass Mode (FR-054) - FOR LOCAL DEMOS ONLY
# WARNING: When enabled, ALL authentication is bypassed! Uses default tenant/user.
# Never enable in production. This is for local demos without Google OAuth setup.
AUTH_BYPASS_ENABLED=1
